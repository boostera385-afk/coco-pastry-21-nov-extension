{
  "manifest_version": 3,
  "name": "Coco Voice Tracker",
  "version": "0.10.0",
  "description": "Counts Google Voice and Vici Dialer activity (kept separate), records calls and syncs them to your team's Coco Voice dashboard.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "sidePanel",
    "scripting",
    "webRequest",
    "contextMenus"
  ],
  "host_permissions": [
    "https://voice.google.com/*",
    "https://*.callengine.org/*",
    "https://yzcjawjncjvqgutpyejm.supabase.co/*",
    "https://*.google.com/*",
    "https://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://voice.google.com/*",
        "https://clients6.google.com/*",
        "https://voice.clients6.google.com/*"
      ],
      "js": [
        "src/interceptor.js",
        "src/recorder.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://voice.google.com/*",
        "https://clients6.google.com/*",
        "https://voice.clients6.google.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://voice.google.com/*"
      ],
      "js": [
        "src/widget.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.callengine.org/*"
      ],
      "js": [
        "src/vici/page.js",
        "src/recorder.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.callengine.org/*"
      ],
      "js": [
        "src/vici/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "action": {
    "default_title": "Coco Voice Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options/options.html",
  "commands": {
    "open-voice": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Open Google Voice (or switch to its tab)"
    }
  }
}
