{
  "manifest_version": 3,
  "name": "Coco Voice Tracker",
  "version": "0.2.0",
  "description": "Counts Google Voice outbound reach and inbound activity and syncs it to your team's Supabase.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://voice.google.com/*", "https://*.supabase.co/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://voice.google.com/*"], "js": ["src/interceptor.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://voice.google.com/*"], "js": ["src/content.js"], "run_at": "document_start" }
  ],
  "action": { "default_popup": "popup/popup.html", "default_title": "Coco Voice Tracker" },
  "options_page": "options/options.html"
}
